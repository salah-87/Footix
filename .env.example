# Copy to .env and change the values. NEVER commit .env.
NODE_ENV=development
PORT=3000
# Application account (limited rights, see db/02_roles.sql)
DATABASE_URL=postgres://footix_app:footix_app_dev@localhost:5432/footix
MONGO_URL=mongodb://localhost:27017/footix
# Two DIFFERENT secrets, at least 32 random characters in production:
JWT_SECRET=change-me-login-secret-change-me-login-secret
TICKET_SECRET=change-me-ticket-secret-change-me-ticket-secret
JWT_EXPIRES_IN=1h
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:5500
MAX_SEATS_PER_ORDER=6
LOGIN_RATE_LIMIT_MAX=10
